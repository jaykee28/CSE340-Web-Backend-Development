<%- include('partials/header') %>

<main class="users-container">

    <h1 class="users-title">
        <%= title %>
    </h1>

    <table>

        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>

            <% users.forEach((user) => { %>

                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><span class="role-badge"><%= user.role_name %></span></td>
                </tr>

            <% }) %>

        </tbody>

    </table>

</main>

<%- include('partials/footer') %>