<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% organizations.forEach((organization) => { %>
        <section class="organization-card">
            <h2>
                <a href="/organization/<%= organization.organization_id %>">
                    <%= organization.organization_name %>
                </a>
            </h2>

            <img
                src="/images/<%= organization.organization_logo %>"
                alt="<%= organization.organization_name %> Logo"
                width="150"
            >

            <p><%= organization.organization_description %></p>
            <p><strong>Email:</strong> <%= organization.organization_email %></p>
        </section>
    <% }) %>

    <% if (locals.user && locals.user.role_name === 'admin') { %>
        <a href="/new-organization">Add a new organization</a>
    <% } %>
</main>

<%- include('partials/footer') %>
