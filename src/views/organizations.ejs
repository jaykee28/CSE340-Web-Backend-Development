<%- include('partials/header') %>

<main>


<h1><%= title %></h1>

<% if (
    locals.user &&
    locals.user.role_name === 'admin'
) { %>

    <a
        href="/new-organization"
        class="action-button"
    >
        Add New Organization
    </a>

<% } %>

<div class="organization-grid">

    <% organizations.forEach(org => { %>

        <article class="organization-card">

            <h2>
                <a href="/organization/<%= org.organization_id %>">
                    <%= org.organization_name %>
                </a>
            </h2>

            <img
                src="/images/<%= org.organization_logo %>"
                alt="<%= org.organization_name %>"
                class="organization-logo"
            >

            <p class="organization-description">
                <%= org.organization_description %>
            </p>

            <p class="organization-email">
                <strong>Email:</strong>
                <%= org.organization_email %>
            </p>

        </article>

    <% }) %>

</div>


</main>

<%- include('partials/footer') %>
