<%- include('partials/header') %>

<main>

    <h1><%= project.project_title %></h1>

    <p>
        <strong>Description:</strong>
        <%= project.project_description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= project.project_date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.project_location %>
    </p>

    <p>
        <strong>Organization:</strong>

        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <% if (isLoggedIn) { %>

        <% if (isVolunteer) { %>

            <p>
                <strong>
                    You are volunteering for this project.
                </strong>
            </p>

            <form
                action="/remove-volunteer/<%= project.project_id %>"
                method="post"
            >
                <button type="submit">
                    Remove Volunteer Signup
                </button>
            </form>

        <% } else { %>

            <form
                action="/volunteer/<%= project.project_id %>"
                method="post"
            >
                <button type="submit">
                    Volunteer For This Project
                </button>
            </form>

        <% } %>

    <% } else { %>

        <p>
            <a href="/login">Log in</a>
            to volunteer for this project.
        </p>

    <% } %>

    <% if (user && user.role_name === 'admin') { %>

        <p>
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        </p>

        <p>
            <a href="/assign-categories/<%= project.project_id %>">
                Edit Categories
            </a>
        </p>

    <% } %>

    <section class="project-categories">

        <h2>Categories</h2>

        <% if (categories.length > 0) { %>

            <% categories.forEach(category => { %>

                <a href="/category/<%= category.category_id %>">
                    <span>
                        <%= category.category_name %>
                    </span>
                </a>

            <% }) %>

        <% } else { %>

            <p>No categories assigned.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>